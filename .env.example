# SEC EDGAR requires a descriptive User-Agent with contact info on every request
EDGAR_USER_AGENT="Your Name your-email@example.com"

# Optional: only needed if you deploy to AWS (S3-backed index/doc store)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=wealth-doc-intelligence

# Local paths (defaults are fine for local dev)
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
FAISS_INDEX_DIR=rag/index
